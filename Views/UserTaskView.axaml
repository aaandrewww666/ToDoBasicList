<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ToDoBasicList.ViewModels"
             mc:Ignorable="d"
             x:DataType="vm:UserTaskViewModel"             
             x:Class="ToDoBasicList.UserTaskView">
    <Design.DataContext>
        <vm:UserTaskViewModel/>
    </Design.DataContext>
  <Grid>
	  <Grid.ColumnDefinitions>
		  <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      
      <CheckBox HorizontalAlignment="Left" IsChecked="{Binding IsCompleted}" />
      
      <Panel Grid.Column="1" Margin="5,0,5,0">
          <TextBox Text="{Binding TaskDescription}" Classes="TextBoxDefaultStyle"
                   IsVisible="{Binding !IsCompleted}" />
          <TextBlock Text="{Binding TaskDescription}" IsVisible="{Binding IsCompleted}"
                     TextDecorations="Strikethrough" Opacity="0.5"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
      </Panel>
      
      <Button Grid.Column="2" Classes="ButtonStyle" Command="{Binding RemoveTaskCommand}" Content="x"/>
  </Grid>
</UserControl>
